--- !u!114 &8806969623198662243
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2716748001641444138}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c2a0029fb1462d04cb7794fb5784e0c4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  anim: {fileID: 344487985}
  RigBuilder: {fileID: 344487984}
  rig: {fileID: 2003097492}
  cheerVoices:
  - {fileID: 8300000, guid: 31c5c839f67ee414d832fe7751b45a82, type: 3}
  - {fileID: 8300000, guid: fb2ebaea4cfc1f4468b298cfd71220f7, type: 3}
  - {fileID: 8300000, guid: adbdc36ee6017f04c984409fa9b846df, type: 3}
  - {fileID: 8300000, guid: 5f1a9f402a8be0c46afb14848f0039aa, type: 3}
  - {fileID: 8300000, guid: 2a1fa43259ed17c4e950282d4a730c1f, type: 3}
  - {fileID: 8300000, guid: 6b5e6dd950fcea844a2ef1c7f8c38b3e, type: 3}
  - {fileID: 8300000, guid: 3dcb5e826e920844b9005d4edf5166ad, type: 3}
  AudioSource: {fileID: 168400600}
  bLookAtPlayer: 1
  sharkIndiviualTimeline: {fileID: 940059206}
  substitleCanvas: {fileID: 4503960438114917329}
  messageBox: {fileID: 4503960438114917328}
  textmeshPro: {fileID: 4503960438114917327}
  introDialouge:
  - "\u201CAlright, crew!\u201D"
  - "\u201CWelcome to the world of VR Game Station!\u201D\n"
  - "\u201COur mission is to defeat the virus robots that are targeting the VR Engine!\u201D\n"
  - "\u201CIf we work together, we can definitely stop them!\u201D"
  - "\u201CCrew, don\u2019t ever back down\u2014let\u2019s beat them!\u201D"
  - "\u201CLook\u2014virus robots have appeared!\u201D"
  - "\u201CAim your blaster and fire!\u201D"
  - "\u201CReady?\u201D"
  bossKilledDialouge:
  - "\u201CThat was awesome. Truly amazing teamwork!\u201D"
  - "\u201CThanks to you, we saved the VR Engine!\u201D\n"
  - "\u201CFrom now on, you\u2019ll see a world of imagination!\u201D\n"
  - "\u201CBut be careful\u2014never cross the boundary!\u201D\n"
  - "\u201COkay then, powering up now!\u201D"
  vrWorldDialouge:
  - "\u201CThanks to you, crew, we were able to protect the VR Game Station!\u201D\n"
  - "\u201CThe virtual reality and augmented reality we experienced today will soon
    be used even more in schools and everyday life!\u201D\n"
  - "\u201COne day, you\u2019ll be able to visit real historical sites in history
    class or explore space and the ocean in science!\u201D\n"
  - "\u201CI had so much fun with you all today!\u201D"
  - "\u201CCrew, let\u2019s go on another adventure together next time. Goodbye!\u201D\n\n"
